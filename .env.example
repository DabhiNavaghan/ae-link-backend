# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# Clerk Auth (required — get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://smartlink.apps.allevents.app

# Default Tenant Settings
DEFAULT_FINGERPRINT_TTL_HOURS=72
DEFAULT_MATCH_THRESHOLD=70

# Logging
LOG_LEVEL=info

# Rate Limiting (in-memory — per process; use Redis if you scale past one container)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_REQUESTS=100
RATE_LIMIT_AUTH_REQUESTS=1000

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://smartlink.apps.allevents.app,https://allevents.in,https://allevents.app,http://localhost:3000

# Email (Gmail SMTP for team invites)
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=SmartLink

# Event rollup cron (POST /api/v1/internal/rollup)
# Shared secret sent as x-cron-secret, or as a Bearer token.
# Not an API key: the endpoint aggregates across every tenant, so no tenant
# should be able to trigger it. Unset means the endpoint refuses to run (503).
CRON_SECRET=

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_DEFERRED_LINKING=true
